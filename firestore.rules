rules_version = '2';

// Firma League — regras do Cloud Firestore
// - users/{uid}: perfil privado. Só o dono lê e escreve, MENOS os campos de vínculo com o Minecraft
//   (verificado, trainer_id, minecraft_uuid…), que só o servidor grava (funções /api com Admin SDK,
//   que ignoram estas regras). Conta verificada também não muda nick nem insígnias pelo navegador:
//   eles vêm do jogo.
// - users/{uid}/teams/{teamId}: times. O dono lê e escreve; times com publico == true podem ser lidos por todos.
// - publicProfiles/{nickLower}: vitrine pública do perfil (/jogador/{nick}). Todos leem; o dono escreve
//   com as mesmas travas acima.
// - treinadores/{uuid}: time, PC e Pokédex vindos do jogo. Só o servidor escreve; todos leem se publico == true.
// - vinculos, link_tokens: só o servidor.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Campos que só o servidor grava.
    function camposServidor() {
      return ['verificado', 'trainer_id', 'minecraft_uuid', 'vinculadoEm', 'level_cap', 'pokedexResumo', 'ultimoVinculo'];
    }
    function mexeEm(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }
    function criaCom(campos) {
      return request.resource.data.keys().hasAny(campos);
    }
    function verificado() {
      return resource.data.get('verificado', false) == true;
    }
    // Atualização permitida pelo navegador: não toca nos campos do servidor e,
    // se a conta for verificada, também não muda nick nem insígnias.
    function updateDoNavegador() {
      return !mexeEm(camposServidor()) && (!verificado() || !mexeEm(['nick', 'insignias']));
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && !criaCom(camposServidor());
      allow update: if isOwner(uid) && updateDoNavegador();

      match /teams/{teamId} {
        allow read: if isOwner(uid) || resource.data.publico == true;
        allow create, update: if isOwner(uid)
          && request.resource.data.pokemon is list
          && request.resource.data.pokemon.size() <= 6
          && request.resource.data.publico is bool;
        allow delete: if isOwner(uid);
      }
    }

    // Consulta "Times da comunidade" (collectionGroup) — só times públicos.
    match /{path=**}/teams/{teamId} {
      allow read: if resource.data.publico == true;
    }

    // Admins: documento admins/{uid} criado à mão no console. Cada um só lê o próprio.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Dados da Liga (ranking e torneios) e liga/meta: todos leem, só admins escrevem pelo site
    // (o servidor Minecraft grava pelas funções /api).
    match /liga/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicProfiles/{nick} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && !criaCom(camposServidor());
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && updateDoNavegador();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Dados do jogo: só o servidor escreve.
    match /treinadores/{uuid} {
      allow read: if resource.data.publico == true || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    match /vinculos/{uuid} {
      allow read, write: if false;
    }
    match /link_tokens/{token} {
      allow read, write: if false;
    }
  }
}
